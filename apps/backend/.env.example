# Secrets (DB_PASSWORD, DB_ADMIN_PASSWORD, OBS_AK, OBS_SK, ORBIT_API_KEY) go only in .env, which is gitignored. The repo is public: never commit them.
NODE_ENV=local
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173

# From a laptop: the RDS EIP. From the cluster: 192.168.0.185.
DB_HOST=<RDS EIP>
DB_PORT=5432
DB_USERNAME=hackaton_app
DB_PASSWORD=
DB_DATABASE=hackaton
# One schema per developer; integration tests use <DB_SCHEMA>_test.
DB_SCHEMA=develop_<name>
# Absolute path to the RDS CA certificate (ca.huawei.com), kept outside the repo.
DB_SSL_CA=
# Admin account, only for manual maintenance; the app never uses it.
DB_ADMIN_USERNAME=root
DB_ADMIN_PASSWORD=

OBS_ENDPOINT=https://obs.la-south-2.myhuaweicloud.com
OBS_REGION=la-south-2
OBS_BUCKET=rca-hackaton
OBS_AK=
OBS_SK=

ORBIT_BASE_URL=https://orbit.dev.core.axmos.tech/openai
ORBIT_API_KEY=
LLM_MODEL_SMALL=glm-5.3
LLM_MODEL_LARGE=glm-5.3
LLM_CONCURRENCY=2
LLM_TIMEOUT_MS=300000

# Embeddings for Q&A run on Ollama; "false" skips the embedding stage and disables the query endpoint.
EMBEDDINGS_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
SEIA_BASE_URL=https://seia.sea.gob.cl
